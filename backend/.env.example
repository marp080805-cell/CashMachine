# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://cashmind:cashmind@localhost:5432/cashmind"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-prod"

# ─── API Server ───────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
WEBHOOK_BASE_URL="http://localhost:3001"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# NEVER commit the real value — set this on the VPS only
ENCRYPTION_KEY="your-64-char-hex-string-here"

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_TYPE="local"           # "local" or "s3"
UPLOAD_DIR="./uploads"

# AWS S3 / Cloudflare R2 (only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET=""

# ─── Google OAuth (Calendar integration) ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/calendar/callback"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
ADMIN_TENANT_NAME="CashMind Demo"
ADMIN_TENANT_SLUG="cashmind"
ADMIN_EMAIL="admin@cashmind.com.br"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="changeme123"
