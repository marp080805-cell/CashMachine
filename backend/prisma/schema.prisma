generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT (MULTI-TENANT SAAS) ──────────────────────────────────

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  plan      TenantPlan @default(FREE)
  settings  Json?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users             User[]
  contacts          Contact[]
  companies         Company[]
  leads             Lead[]
  opportunities     Opportunity[]
  pipelines         Pipeline[]
  origins           Origin[]
  lostReasons       LostReason[]
  tags              Tag[]
  customFieldGroups CustomFieldGroup[]
  activities        Activity[]
  tasks             Task[]
  whatsappNumbers   WhatsappNumber[]
  notifications     Notification[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  STANDARD
  PRO
  ENTERPRISE
}

// ─── USUÁRIOS ─────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  avatarUrl    String?
  role         UserRole  @default(SDR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedOpportunities Opportunity[]  @relation("AssignedTo")
  sdrOpportunities      Opportunity[]  @relation("SDR")
  closerOpportunities   Opportunity[]  @relation("Closer")
  activities            Activity[]
  tasks                 Task[]         @relation("AssignedTasks")
  createdTasks          Task[]         @relation("CreatedTasks")
  whatsappNumbers       WhatsappNumber[]
  createdTags           Tag[]
  movedStages           StageHistory[]
  tagAssignments        TagAssignment[]
  customFieldValues     CustomFieldValue[]
  notifications         Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  SDR
  CLOSER
  VIEWER
}

// ─── CONTATOS (PESSOAS — entidade fixa) ───────────────────────────

model Contact {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  cpfCnpj          String?
  originId         String?
  origin           Origin?    @relation(fields: [originId], references: [id])
  subOriginId      String?
  subOrigin        SubOrigin? @relation(fields: [subOriginId], references: [id])
  companyId        String?
  company          Company?   @relation(fields: [companyId], references: [id])
  firstContactDate DateTime?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  opportunities  Opportunity[]
  leads          Lead[]
  activities     Activity[]
  tasks          Task[]
  conversations  WhatsappConversation[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
}

// ─── EMPRESAS ─────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  cnpj      String?
  segment   String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@map("companies")
}

// ─── LEADS (lista pré-levantada — NÃO está no pipeline) ───────────

model Lead {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source    String?
  status    LeadStatus @default(NEW)
  score     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
}

// ─── PIPELINE (FUNIL) ─────────────────────────────────────────────

model Pipeline {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  prefix           String?
  description      String?
  type             PipelineType @default(SALES)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  defaultCloseDays Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  stages        Stage[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@map("pipelines")
}

enum PipelineType {
  SALES
  TREATMENT
  RESCUE
  RELATIONSHIP
  CUSTOM
}

// ─── ETAPA DO PIPELINE ────────────────────────────────────────────

model Stage {
  id             String   @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  color          String   @default("#6366f1")
  sortOrder      Int      @default(0)
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  requiredFields Json?
  visibleFields  Json?
  description    String?
  createdAt      DateTime @default(now())

  opportunities  Opportunity[]
  stageHistories StageHistory[]
  tasks          Task[]

  @@index([pipelineId])
  @@map("stages")
}

// ─── HISTÓRICO DE MOVIMENTAÇÃO ────────────────────────────────────

model StageHistory {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stageId         String
  stage           Stage       @relation(fields: [stageId], references: [id])
  enteredAt       DateTime    @default(now())
  exitedAt        DateTime?
  movedById       String
  movedBy         User        @relation(fields: [movedById], references: [id])
  durationSeconds Int?

  @@index([opportunityId])
  @@index([stageId])
  @@map("stage_histories")
}

// ─── OPORTUNIDADE (CARD NO PIPELINE) ─────────────────────────────

model Opportunity {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact           @relation(fields: [contactId], references: [id])
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id])
  pipelineId         String
  pipeline           Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              Stage             @relation(fields: [stageId], references: [id])
  assignedToId       String
  assignedTo         User              @relation("AssignedTo", fields: [assignedToId], references: [id])
  sdrId              String?
  sdr                User?             @relation("SDR", fields: [sdrId], references: [id])
  closerId           String?
  closer             User?             @relation("Closer", fields: [closerId], references: [id])
  title              String
  value              Decimal?          @db.Decimal(12, 2)
  originId           String?
  origin             Origin?           @relation(fields: [originId], references: [id])
  subOriginId        String?
  subOrigin          SubOrigin?        @relation(fields: [subOriginId], references: [id])
  expectedCloseDate  DateTime?
  closedAt           DateTime?
  lostReasonId       String?
  lostReason         LostReason?       @relation(fields: [lostReasonId], references: [id])
  rescueEligible     Boolean           @default(false)
  temperature        Temperature?
  qualificationScore Int?
  position           Int               @default(0)
  handoffAt          DateTime?
  sdrBriefing        String?
  slaFirstContactAt  DateTime?
  status             OpportunityStatus @default(OPEN)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  stageHistories StageHistory[]
  activities     Activity[]
  tasks          Task[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([assignedToId])
  @@map("opportunities")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum Temperature {
  COLD
  WARM
  HOT
}

// ─── ORIGEM ───────────────────────────────────────────────────────

model Origin {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  subOrigins    SubOrigin[]
  contacts      Contact[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@map("origins")
}

model SubOrigin {
  id        String   @id @default(uuid())
  originId  String
  origin    Origin   @relation(fields: [originId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  contacts      Contact[]
  opportunities Opportunity[]

  @@index([originId])
  @@map("sub_origins")
}

// ─── MOTIVO DE PERDA ──────────────────────────────────────────────

model LostReason {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([tenantId])
  @@map("lost_reasons")
}

// ─── TAGS COM GOVERNANÇA ──────────────────────────────────────────

model Tag {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  color       String      @default("#6366f1")
  category    TagCategory @default(CUSTOM)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  isLocked    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  assignments TagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

enum TagCategory {
  QUALIFICATION
  TEMPERATURE
  STATUS
  CUSTOM
}

model TagAssignment {
  id           String    @id @default(uuid())
  tagId        String
  tag          Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType   String    // "opportunity" | "contact"
  entityId     String
  assignedAt   DateTime  @default(now())
  assignedById String
  assignedBy   User      @relation(fields: [assignedById], references: [id])
  removedAt    DateTime?

  @@index([tagId])
  @@index([entityType, entityId])
  @@map("tag_assignments")
}

// ─── CAMPOS PERSONALIZADOS ────────────────────────────────────────

model CustomFieldGroup {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType          String   // "opportunity" | "contact" | "company"
  name                String
  sortOrder           Int      @default(0)
  isCollapsedByDefault Boolean @default(false)
  createdAt           DateTime @default(now())

  customFields CustomField[]

  @@index([tenantId])
  @@map("custom_field_groups")
}

model CustomField {
  id                String          @id @default(uuid())
  groupId           String
  group             CustomFieldGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entityType        String          // "opportunity" | "contact" | "company"
  name              String
  slug              String
  fieldType         CustomFieldType
  options           Json?           // para select/multiselect
  isRequiredGlobal  Boolean         @default(false)
  requiredInStages  Json?           // array de stage IDs
  visibleInStages   Json?           // array de stage IDs (null = sempre visível)
  showInCard        Boolean         @default(false)
  tooltip           String?
  defaultValue      String?
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  values CustomFieldValue[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  DATETIME
  SELECT
  MULTISELECT
  CHECKBOX
  URL
  PHONE
  EMAIL
  CURRENCY
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityType    String      // "opportunity" | "contact" | "company"
  entityId      String
  valueText     String?
  valueNumber   Decimal?    @db.Decimal(18, 4)
  valueDate     DateTime?
  valueJson     Json?
  updatedAt     DateTime    @updatedAt
  updatedById   String
  updatedBy     User        @relation(fields: [updatedById], references: [id])

  @@unique([customFieldId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

// ─── ATIVIDADES (LOG DE AÇÕES) ────────────────────────────────────

model Activity {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  metadata      Json?
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([userId])
  @@map("activities")
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  WHATSAPP_MESSAGE
  OPPORTUNITY_MOVED
  OPPORTUNITY_CREATED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  TASK_COMPLETED
  FILE_UPLOADED
  AI_SUGGESTION
  STAGE_CHANGED
  HANDOFF
}

// ─── TAREFAS ──────────────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id])
  stageId       String?
  stage         Stage?     @relation(fields: [stageId], references: [id])
  assignedToId  String
  assignedTo    User       @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User       @relation("CreatedTasks", fields: [createdById], references: [id])
  title         String
  description   String?
  type          TaskType   @default(FOLLOW_UP)
  dueDate       DateTime?
  completedAt   DateTime?
  completedById String?
  completionNotes String?
  isAutomated   Boolean    @default(false)
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus  @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskType {
  FIRST_CONTACT
  FOLLOW_UP
  QUALIFY
  SCHEDULE_MEETING
  CONFIRM_PRESENCE
  PREPARE_BRIEFING
  SEND_PROPOSAL
  FOLLOW_UP_PROPOSAL
  CALL
  MEETING
  EMAIL
  REMINDER
  RESCUE_CONTACT
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  OVERDUE
}

// ─── WHATSAPP ─────────────────────────────────────────────────────

model WhatsappNumber {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String          @unique
  instanceName String          @unique
  apiUrl       String?
  apiKey       String?
  status       WhatsappStatus  @default(DISCONNECTED)
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  conversations WhatsappConversation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@map("whatsapp_numbers")
}

enum WhatsappStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
}

model WhatsappConversation {
  id            String             @id @default(uuid())
  remoteJid     String
  remotePhone   String
  remoteName    String?
  remoteAvatar  String?
  numberId      String
  number        WhatsappNumber     @relation(fields: [numberId], references: [id])
  contactId     String?
  contact       Contact?           @relation(fields: [contactId], references: [id])
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int                @default(0)
  isArchived    Boolean            @default(false)
  messages      WhatsappMessage[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([numberId, remoteJid])
  @@index([numberId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id               String               @id @default(uuid())
  remoteId         String               @unique
  conversationId   String
  conversation     WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content          String?
  type             MessageType          @default(TEXT)
  mediaUrl         String?
  fromMe           Boolean              @default(false)
  status           MessageStatus        @default(SENT)
  aiSuggestion     String?
  aiSuggestionUsed Boolean              @default(false)
  timestamp        DateTime
  createdAt        DateTime             @default(now())

  @@index([conversationId])
  @@index([timestamp])
  @@map("whatsapp_messages")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── IA — TRANSCRIÇÕES ────────────────────────────────────────────

model CallTranscription {
  id            String              @id @default(uuid())
  tenantId      String
  title         String
  audioUrl      String?
  transcript    String?
  duration      Int?
  contactId     String?
  opportunityId String?
  analysis      Json?
  status        TranscriptionStatus @default(PENDING)
  uploadedById  String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId])
  @@index([uploadedById])
  @@index([status])
  @@map("call_transcriptions")
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

// ─── NOTIFICAÇÕES ─────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  TASK_DUE
  OPPORTUNITY_ASSIGNED
  WHATSAPP_MESSAGE
  AI_SUGGESTION
  REPORT_READY
  HANDOFF_RECEIVED
  SYSTEM
}
