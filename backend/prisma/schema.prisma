  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages WhatsappMessage[]

  @@unique([numberId, remoteJid])
  @@index([numberId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id               String               @id @default(uuid())
