generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT (MULTI-TENANT SAAS) ──────────────────────────────────

model Tenant {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  plan         TenantPlan @default(FREE)
  settings     Json?
  openaiApiKey String?    // chave OpenAI do cliente (encryptada)
  openaiModel  String?    @default("gpt-4o")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  users             User[]
  contacts          Contact[]
  companies         Company[]
  leads             Lead[]
  opportunities     Opportunity[]
  pipelines         Pipeline[]
  origins           Origin[]
  lostReasons       LostReason[]
  tags              Tag[]
  customFieldGroups CustomFieldGroup[]
  activities        Activity[]
  tasks             Task[]
  taskTemplates     TaskTemplate[]
  whatsappNumbers   WhatsappNumber[]
  notifications     Notification[]
  meetings          Meeting[]
  bookingPages      BookingPage[]
  stageTriggers     StageTrigger[]
  salesBots         SalesBot[]
  conversations     Conversation[]
  messageTemplates  MessageTemplate[]
  aiAgents          AIAgent[]
  recordings        Recording[]
  goals             Goal[]
  dailyMetrics      DailyMetrics[]
  forms             Form[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ─── USUÁRIOS ─────────────────────────────────────────────────────

model User {
  id                        String    @id @default(uuid())
  tenantId                  String
  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                      String
  email                     String
  passwordHash              String
  avatarUrl                 String?
  role                      UserRole  @default(SDR)
  isActive                  Boolean   @default(true)
  notificationPreferences   Json?
  lastLoginAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  assignedOpportunities      Opportunity[]           @relation("AssignedTo")
  sdrOpportunities           Opportunity[]           @relation("SDR")
  closerOpportunities        Opportunity[]           @relation("Closer")
  activities                 Activity[]
  tasks                      Task[]                  @relation("AssignedTasks")
  createdTasks               Task[]                  @relation("CreatedTasks")
  completedTasks             Task[]                  @relation("CompletedTasks")
  whatsappNumbers            WhatsappNumber[]
  createdTags                Tag[]
  movedStages                StageHistory[]
  tagAssignments             TagAssignment[]
  customFieldValues          CustomFieldValue[]
  notifications              Notification[]
  calendarIntegrations       CalendarIntegration[]
  userAvailabilities         UserAvailability[]
  organizedMeetings          Meeting[]               @relation("OrganizedMeetings")
  hostedMeetings             Meeting[]               @relation("HostedMeetings")
  bookingPages               BookingPage[]           @relation("BookingPages")
  opportunityAssignments     OpportunityAssignment[] @relation("OpportunityAssignments")
  assignedByAssignments      OpportunityAssignment[] @relation("AssignedByAssignments")
  createdBots                SalesBot[]              @relation("CreatedBots")
  conversationAssignments    Conversation[]          @relation("ConversationAssignees")
  sentMessages               Message[]               @relation("SentMessages")
  closerRecordings           Recording[]             @relation("CloserRecordings")
  goals                      Goal[]                  @relation("UserGoals")
  formAssignments            Form[]                  @relation("FormAssignees")
  createdTemplates           AccountTemplate[]       @relation("CreatedTemplates")
  assignedContacts           Contact[]               @relation("AssignedContacts")
  assignedCompanies          Company[]               @relation("AssignedCompanies")
  assignedLeads              Lead[]                  @relation("AssignedLeads")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  SDR
  CLOSER
  VIEWER
}

// ─── CONTATOS (PESSOAS — entidade fixa) ───────────────────────────

model Contact {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  whatsapp         String?
  mobile           String?
  fax              String?
  extension        String?
  cpf              String?
  cpfCnpj          String?    // legado — mantido para retrocompatibilidade
  role             String?
  nationality      String?
  category         String?
  website          String?
  dateOfBirth      DateTime?
  avatarUrl        String?
  originId         String?
  origin           Origin?    @relation(fields: [originId], references: [id])
  subOriginId      String?
  subOrigin        SubOrigin? @relation(fields: [subOriginId], references: [id])
  companyId        String?
  company          Company?   @relation(fields: [companyId], references: [id])
  address          Json?      // {street, number, complement, city, state, zip, country}
  socialProfiles   Json?      // {instagram, linkedin, facebook, twitter, tiktok, skype}
  firstContactDate DateTime?
  notes            String?
  isBlacklisted    Boolean    @default(false)
  assignedToId     String?
  assignedTo       User?      @relation("AssignedContacts", fields: [assignedToId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  opportunities      Opportunity[]
  leads              Lead[]
  activities         Activity[]
  tasks              Task[]
  conversations      WhatsappConversation[]
  newConversations   Conversation[]          @relation("ContactConversations")
  meetings           Meeting[]               @relation("ContactMeetings")
  salesBotExecutions SalesBotExecution[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
}

// ─── EMPRESAS ─────────────────────────────────────────────────────

model Company {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  legalName     String?  // Razão social
  cnpj          String?
  category      String?  // Categoria
  segment       String?  // Setor
  website       String?
  email         String?
  phone         String?
  whatsapp      String?
  mobile        String?
  fax           String?
  extension     String?  // Ramal
  address       String?
  addressJson   Json?    // {street, number, complement, city, state, zip, country}
  socialProfiles Json?   // {linkedin, instagram, facebook, twitter}
  employeeCount Int?
  annualRevenue Decimal? @db.Decimal(15, 2)
  originId      String?
  origin        Origin?  @relation(fields: [originId], references: [id])
  assignedToId  String?
  assignedTo    User?    @relation("AssignedCompanies", fields: [assignedToId], references: [id])
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]        @relation("CompanyTasks")

  @@index([tenantId])
  @@map("companies")
}

// ─── LEADS (lista pré-levantada — NÃO está no pipeline) ───────────

model Lead {
  id                         String     @id @default(uuid())
  tenantId                   String
  tenant                     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId                  String
  contact                    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source                     String?
  sourceDetail               String?
  status                     LeadStatus @default(NEW)
  score                      Int        @default(0)
  qualifiedAt                DateTime?
  disqualifiedReason         String?
  convertedToOpportunityId   String?
  assignedToId               String?
  assignedTo                 User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

enum LeadStatus {
  NEW
  NURTURING
  QUALIFIED
  DISQUALIFIED
}

// ─── PIPELINE (FUNIL) ─────────────────────────────────────────────

model Pipeline {
  id                    String         @id @default(uuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  prefix                String?
  description           String?
  type                  PipelineType   @default(SALES)
  isActive              Boolean        @default(true)
  sortOrder             Int            @default(0)
  defaultCloseDays      Int?
  sdrStages             Json?          // array de stage_ids
  closerStages          Json?          // array de stage_ids
  handoffStageId        String?
  handoffRequiredFields Json?          // array de field_slugs
  autoAssignCloser      AutoAssignMode @default(MANUAL)
  fixedCloserId         String?
  roundRobinUserIds     Json?          // array de user_ids
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  stages        Stage[]
  opportunities Opportunity[]
  stageTriggers StageTrigger[]

  @@index([tenantId])
  @@map("pipelines")
}

enum PipelineType {
  SALES
  TREATMENT
  RESCUE
  RELATIONSHIP
  CUSTOM
}

enum AutoAssignMode {
  MANUAL
  ROUND_ROBIN
  BY_SPECIALTY
  FIXED
}

// ─── ETAPA DO PIPELINE ────────────────────────────────────────────

model Stage {
  id              String    @id @default(uuid())
  pipelineId      String
  pipeline        Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name            String
  color           String    @default("#6366f1")
  sortOrder       Int       @default(0)
  type            StageType @default(NORMAL)
  isWon           Boolean   @default(false)  // mantido para retrocompatibilidade
  isLost          Boolean   @default(false)  // mantido para retrocompatibilidade
  probability     Int       @default(0)      // 0-100 para forecast
  requiredFields  Json?
  visibleFields   Json?
  autoCreateTasks Json?     // array de TaskTemplate configs
  description     String?
  createdAt       DateTime  @default(now())

  opportunities  Opportunity[]
  stageHistories StageHistory[]
  tasks          Task[]
  stageTriggers  StageTrigger[]

  @@index([pipelineId])
  @@map("stages")
}

enum StageType {
  NORMAL
  WON
  LOST
}

// ─── HISTÓRICO DE MOVIMENTAÇÃO ────────────────────────────────────

model StageHistory {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stageId         String
  stage           Stage       @relation(fields: [stageId], references: [id])
  enteredAt       DateTime    @default(now())
  exitedAt        DateTime?
  movedById       String
  movedBy         User        @relation(fields: [movedById], references: [id])
  durationSeconds Int?

  @@index([opportunityId])
  @@index([stageId])
  @@map("stage_histories")
}

// ─── OPORTUNIDADE (CARD NO PIPELINE) ─────────────────────────────

model Opportunity {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact           @relation(fields: [contactId], references: [id])
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id])
  pipelineId         String
  pipeline           Pipeline          @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              Stage             @relation(fields: [stageId], references: [id])
  assignedToId       String
  assignedTo         User              @relation("AssignedTo", fields: [assignedToId], references: [id])
  sdrId              String?
  sdr                User?             @relation("SDR", fields: [sdrId], references: [id])
  closerId           String?
  closer             User?             @relation("Closer", fields: [closerId], references: [id])
  title              String
  value              Decimal?          @db.Decimal(12, 2)
  monthlyValue       Decimal?          @db.Decimal(12, 2)
  installments       Int?
  installmentValue   Decimal?          @db.Decimal(12, 2)
  paymentDetails     Json?
  originId           String?
  origin             Origin?           @relation(fields: [originId], references: [id])
  subOriginId        String?
  subOrigin          SubOrigin?        @relation(fields: [subOriginId], references: [id])
  channel            String?
  expectedCloseDate  DateTime?
  closedAt           DateTime?
  lostReasonId       String?
  lostReason         LostReason?       @relation(fields: [lostReasonId], references: [id])
  lostReasonDetail   String?
  rescueEligible     Boolean           @default(false)
  temperature        Temperature?
  qualificationScore Int?
  qualificationNotes String?
  position           Int               @default(0)
  handoffAt          DateTime?
  sdrBriefing        String?
  slaFirstContactAt  DateTime?
  firstContactDate   DateTime?
  scheduledDate      DateTime?
  attendedDate       DateTime?
  proposalSentDate   DateTime?
  wonDate            DateTime?
  lostDate           DateTime?
  status             OpportunityStatus @default(OPEN)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  stageHistories     StageHistory[]
  activities         Activity[]
  tasks              Task[]
  meetings           Meeting[]
  conversations      Conversation[]          @relation("OpportunityConversations")
  tagAssignments     TagAssignment[]
  assignments        OpportunityAssignment[]
  salesBotExecutions SalesBotExecution[]
  stageTriggerLogs   StageTriggerLog[]
  recordings         Recording[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([assignedToId])
  @@map("opportunities")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum Temperature {
  COLD
  WARM
  HOT
}

// ─── ATRIBUIÇÃO DE RESPONSÁVEIS (HISTÓRICO) ───────────────────────

model OpportunityAssignment {
  id            String         @id @default(uuid())
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation("OpportunityAssignments", fields: [userId], references: [id])
  role          AssignmentRole
  assignedAt    DateTime       @default(now())
  unassignedAt  DateTime?
  assignedById  String
  assignedBy    User           @relation("AssignedByAssignments", fields: [assignedById], references: [id])
  isCurrent     Boolean        @default(true)

  @@index([opportunityId])
  @@index([userId])
  @@map("opportunity_assignments")
}

enum AssignmentRole {
  SDR
  CLOSER
  MANAGER
}

// ─── ORIGEM ───────────────────────────────────────────────────────

model Origin {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  // Árvore recursiva ilimitada
  parentId  String?
  parent    Origin?   @relation("OriginChildren", fields: [parentId], references: [id])
  children  Origin[]  @relation("OriginChildren")

  subOrigins     SubOrigin[]
  contacts       Contact[]
  companies      Company[]
  opportunities  Opportunity[]
  goals          Goal[]
  goalBreakdowns GoalBreakdown[] @relation("GoalBreakdownOrigin")

  @@index([tenantId])
  @@index([parentId])
  @@map("origins")
}

model SubOrigin {
  id        String   @id @default(uuid())
  originId  String
  origin    Origin   @relation(fields: [originId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  contacts       Contact[]
  opportunities  Opportunity[]
  goals          Goal[]
  goalBreakdowns GoalBreakdown[] @relation("GoalBreakdownSubOrigin")

  @@index([originId])
  @@map("sub_origins")
}

// ─── MOTIVO DE PERDA ──────────────────────────────────────────────

model LostReason {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([tenantId])
  @@map("lost_reasons")
}

// ─── TAGS COM GOVERNANÇA ──────────────────────────────────────────

model Tag {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  color       String      @default("#6366f1")
  category    TagCategory @default(CUSTOM)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  isLocked    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  assignments TagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

enum TagCategory {
  QUALIFICATION
  TEMPERATURE
  STATUS
  AI_CONTROL
  CUSTOM
}

model TagAssignment {
  id           String      @id @default(uuid())
  tagId        String
  tag          Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType   String      // "opportunity" | "contact"
  entityId     String
  assignedAt   DateTime    @default(now())
  assignedById String
  assignedBy   User        @relation(fields: [assignedById], references: [id])
  removedAt    DateTime?
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([tagId])
  @@index([entityType, entityId])
  @@map("tag_assignments")
}

// ─── CAMPOS PERSONALIZADOS ────────────────────────────────────────

model CustomFieldGroup {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType           String   // "opportunity" | "contact" | "company"
  name                 String
  sortOrder            Int      @default(0)
  isCollapsedByDefault Boolean  @default(false)
  createdAt            DateTime @default(now())

  customFields CustomField[]

  @@index([tenantId])
  @@map("custom_field_groups")
}

model CustomField {
  id               String           @id @default(uuid())
  groupId          String
  group            CustomFieldGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entityType       String           // "opportunity" | "contact" | "company"
  name             String
  slug             String
  fieldType        CustomFieldType
  options          Json?            // para select/multiselect
  isRequiredGlobal Boolean          @default(false)
  requiredInStages Json?            // array de stage IDs
  visibleInStages  Json?            // array de stage IDs (null = sempre visível)
  showInCard       Boolean          @default(false)
  tooltip          String?
  placeholder      String?
  defaultValue     String?
  validationRules  Json?
  sortOrder        Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  values CustomFieldValue[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  DATE
  DATETIME
  SELECT
  MULTISELECT
  CHECKBOX
  RADIO
  URL
  PHONE
  EMAIL
  CURRENCY
  FILE
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityType    String      // "opportunity" | "contact" | "company"
  entityId      String
  valueText     String?
  valueNumber   Decimal?    @db.Decimal(18, 4)
  valueDate     DateTime?
  valueJson     Json?
  updatedAt     DateTime    @updatedAt
  updatedById   String
  updatedBy     User        @relation(fields: [updatedById], references: [id])

  @@unique([customFieldId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

// ─── ATIVIDADES (LOG DE AÇÕES) ────────────────────────────────────

model Activity {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          ActivityType
  description   String
  metadata      Json?
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([userId])
  @@map("activities")
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  WHATSAPP_MESSAGE
  OPPORTUNITY_MOVED
  OPPORTUNITY_CREATED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  TASK_COMPLETED
  FILE_UPLOADED
  AI_SUGGESTION
  STAGE_CHANGED
  HANDOFF
}

// ─── TAREFAS ──────────────────────────────────────────────────────

model TaskTemplate {
  id                  String       @id @default(uuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  type                TaskType
  titleTemplate       String
  descriptionTemplate String?
  defaultPriority     TaskPriority @default(MEDIUM)
  dueDateRelativeTo   String?      // "opportunity_created"|"stage_entered"|"meeting_date"|"custom_field_date"
  dueOffsetMinutes    Int?
  slaMinutes          Int?
  assignedRole        String?      // "sdr"|"closer"|"manager"|"auto_round_robin"
  createdAt           DateTime     @default(now())

  tasks Task[]

  @@index([tenantId])
  @@map("task_templates")
}

model Task {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id])
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id])
  companyId         String?
  company           Company?      @relation("CompanyTasks", fields: [companyId], references: [id])
  stageId           String?
  stage             Stage?        @relation(fields: [stageId], references: [id])
  meetingId         String?
  meeting           Meeting?      @relation(fields: [meetingId], references: [id])
  templateId        String?
  template          TaskTemplate? @relation(fields: [templateId], references: [id])
  assignedToId      String
  assignedTo        User          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById       String
  createdBy         User          @relation("CreatedTasks", fields: [createdById], references: [id])
  completedById     String?
  completedBy       User?         @relation("CompletedTasks", fields: [completedById], references: [id])
  title             String
  description       String?
  type              TaskType      @default(FOLLOW_UP)
  dueDate           DateTime?
  dueDateRelativeTo String?
  dueOffsetMinutes  Int?
  completedAt       DateTime?
  completionNotes   String?
  isAutomated       Boolean       @default(false)
  automationId      String?
  priority          TaskPriority  @default(MEDIUM)
  status            TaskStatus    @default(PENDING)
  slaMinutes        Int?
  slaBreach         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
  @@index([opportunityId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

enum TaskType {
  FIRST_CONTACT
  FOLLOW_UP
  QUALIFY
  SCHEDULE_MEETING
  CONFIRM_PRESENCE
  PREPARE_BRIEFING
  SEND_PROPOSAL
  FOLLOW_UP_PROPOSAL
  CALL
  MEETING
  EMAIL
  REMINDER
  RESCUE_CONTACT
  NPS_FOLLOW_UP
  SEND_RECORDING_ACTION
  CUSTOM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  OVERDUE
}

// ─── CALENDÁRIO E REUNIÕES ────────────────────────────────────────

model CalendarIntegration {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     CalendarProvider
  accessToken  String
  refreshToken String?
  calendarId   String?
  isActive     Boolean          @default(true)
  connectedAt  DateTime         @default(now())
  lastSyncedAt DateTime?

  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_integrations")
}

enum CalendarProvider {
  GOOGLE_CALENDAR
  OUTLOOK
}

model UserAvailability {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek           DayOfWeek
  startTime           String
  endTime             String
  slotDurationMinutes Int       @default(60)
