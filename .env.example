# ── OPENAI ───────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── EMAIL (Resend) ────────────────────────────────────────────────
RESEND_API_KEY="re_..."
